# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен попадать в git (см. .gitignore).

# Ключ OpenAI. Пока ключа нет / для локальной разработки без затрат —
# оставьте MOCK_LLM=true, тогда сервис будет использовать простую
# эвристику вместо реального обращения к LLM.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# true = не дергать OpenAI, использовать встроенную заглушку (бесплатно, для теста)
MOCK_LLM=true

# Лимит запросов в минуту на один client_id
RATE_LIMIT_PER_MINUTE=5
